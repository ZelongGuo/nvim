% mycommon.sty
% Common settings shared by myarticle / myreport / mybook

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mycommon}[2026/04/11 Common settings for custom classes]

% ----------------------------------------------------------------------
% Engine check
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{mycommon}
    {This style requires XeLaTeX or LuaLaTeX}
    {Please compile with xelatex or lualatex.}
\fi

% ----------------------------------------------------------------------
% Basic packages
\RequirePackage[UTF8, scheme=plain]{ctex}
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage[normalem]{ulem}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage{amssymb}
\RequirePackage{esint}
\RequirePackage{cancel}
\RequirePackage{fancyhdr}
\RequirePackage{natbib}
\RequirePackage{tikz}
\RequirePackage{todonotes}

% Font-related packages
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{ifplatform}

% Hyperref relatively late
\RequirePackage{hyperref}

% ----------------------------------------------------------------------
% TikZ / todo notes
\usetikzlibrary{calc,arrows.meta}
\setuptodonotes{fancyline, color=green!90!, inlinewidth=\textwidth}

% ----------------------------------------------------------------------
% Theorem
\newtheorem{theorem}{Theorem}

% ----------------------------------------------------------------------
% Font path for non-macOS systems
\newcommand{\myfontspath}{/home/zelong/.config/fonts/}

% ----------------------------------------------------------------------
% macOS font setup
\newcommand{\setupfonts@mac}{%
  % English
  \setmainfont{Times New Roman}

  % Chinese families
  \setCJKfamilyfont{zhsong}[
    UprightFont = * Light,
    BoldFont    = * Bold,
    AutoFakeSlant = 0.2
  ]{Songti SC}

  \setCJKfamilyfont{zhkai}[
    BoldFont = * Black,
    AutoFakeSlant = 0.2
  ]{Kaiti SC}

  % Default Chinese main font
  \setCJKmainfont[
    BoldFont = * Black,
    AutoFakeSlant = 0.2
  ]{Kaiti SC}
}

% ----------------------------------------------------------------------
% Linux font setup
\newcommand{\setupfonts@linux}{%
  % English
  \setmainfont[
    Path = \myfontspath english/,
    AutoFakeSlant=0.3,
    AutoFakeBold=2,
  ]{TimesNewRoman.ttf}

  % Chinese families
  \setCJKfamilyfont{zhsong}[
    Path = \myfontspath chinese/,
    AutoFakeBold = 2,
    AutoFakeSlant = 0.2
  ]{simsun.ttc}

  \setCJKfamilyfont{zhkai}[
    Path = \myfontspath chinese/,
    AutoFakeBold = 2,
    AutoFakeSlant = 0.2
  ]{simkai.ttf}

  % Default Chinese main font
  \setCJKmainfont[
    Path = \myfontspath chinese/,
    AutoFakeBold = 2,
    AutoFakeSlant = 0.2
  ]{simkai.ttf}
}

% ----------------------------------------------------------------------
% Other systems: same as Linux
\newcommand{\setupfonts@other}{%
  % English
  \setmainfont[
    Path = \myfontspath english/,
    AutoFakeSlant=0.3,
    AutoFakeBold=2,
  ]{TimesNewRoman.ttf}

  % Chinese families
  \setCJKfamilyfont{zhsong}[
    Path = \myfontspath chinese/,
    AutoFakeBold = 2,
    AutoFakeSlant = 0.2
  ]{simsun.ttc}

  \setCJKfamilyfont{zhkai}[
    Path = \myfontspath chinese/,
    AutoFakeBold = 2,
    AutoFakeSlant = 0.2
  ]{simkai.ttf}

  % Default Chinese main font
  \setCJKmainfont[
    Path = \myfontspath chinese/,
    AutoFakeBold = 2,
    AutoFakeSlant = 0.2
  ]{simkai.ttf}
}

% ----------------------------------------------------------------------
% Detect OS and load fonts
% Note: ifplatform may depend on shell-escape in some environments.
\ifmacosx
  \setupfonts@mac
\else
  \iflinux
    \setupfonts@linux
  \else
    \setupfonts@other
  \fi
\fi

% ----------------------------------------------------------------------
% Chinese family switching commands
\newcommand{\song}{\CJKfamily{zhsong}}
\newcommand{\kai}{\CJKfamily{zhkai}}

% Default body Chinese style: Kai
\AtBeginDocument{%
  \kai
}

% ----------------------------------------------------------------------
% Optional Nerd Font command
\IfFontExistsTF{Hack Nerd Font}{%
  \newfontfamily\nerdfont{Hack Nerd Font}
}{}

% ----------------------------------------------------------------------
% Font size and line spacing
\renewcommand\normalsize{\fontsize{10pt}{15pt}\selectfont}
\setlength{\headheight}{15.0pt}

% ----------------------------------------------------------------------
% Page layout
\geometry{a4paper, scale=0.8}
\pagestyle{fancy}

% ----------------------------------------------------------------------
% Colors
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

% ----------------------------------------------------------------------
% Listings style
\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},
    commentstyle=\color{red!50!green!50!blue!50},
    keywordstyle=\color{blue!70},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\footnotesize,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    frame=single,
    showstringspaces=false
}
\lstset{style=mystyle}

% ----------------------------------------------------------------------
% Lua language for listings
\lstdefinelanguage{lua}{
  morekeywords={and,break,do,else,elseif,end,false,for,function,if,in,
                local,nil,not,or,repeat,return,then,true,until,while},
  sensitive=true,
  morecomment=[l]{--},
  morecomment=[s]{--[[}{]]},
  morestring=[b]",
  morestring=[b]',
  keywordstyle=\color{blue!70},
  commentstyle=\color{red!50!green!50!blue!50},
  stringstyle=\color{codepurple},
  basicstyle=\ttfamily\footnotesize,
  breaklines=true,
  keepspaces=true,
  numbers=left,
  numbersep=5pt,
  frame=single,
  showstringspaces=false
}

% ----------------------------------------------------------------------
% enumitem settings
\setlist[itemize]{itemsep=0.5ex, parsep=0ex, topsep=0.8ex}
\setlist[enumerate]{itemsep=0.5ex, parsep=0ex, topsep=0.8ex}

\setlist[itemize,1]{label=$\bullet$}
\setlist[itemize,2]{label=$\diamond$}
\setlist[itemize,3]{label=$\triangleright$}
\setlist[itemize,4]{label=$\circ$}

\setlist[enumerate,1]{label=\arabic*.}
\setlist[enumerate,2]{label=(\arabic*).}
\setlist[enumerate,3]{label=\alph*.}
\setlist[enumerate,4]{label=(\alph*).}

% ----------------------------------------------------------------------
% Hyperref settings
\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    citecolor=black,
    filecolor=magenta,
    urlcolor=cyan
}

